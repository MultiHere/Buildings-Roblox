{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "SearchPlugins",
      "SuggestPluginInstall",
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/budget.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/budget.py\""
          }
        ]
      }
    ]
  }
}